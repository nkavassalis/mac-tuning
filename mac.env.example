# Copy to mac.env (untracked) and fill in. Sourced by scripts/*.sh.
MAC=mac-host                    # SSH target of the Mac (runs rec serve)
MAC_KEY=~/.ssh/id_mac           # SSH key for the Mac
WORKER=user@worker-host         # a Linux box with docker + spark-tuning's ~/spark-quality harness (runs generation + sandbox)
SPARK=../spark-tuning           # local spark-tuning checkout (harness source)
